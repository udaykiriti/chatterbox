# Chatterbox Gateway Environment Configuration
# Copy to /etc/chatterbox-gateway.env and set secure permissions:
#   sudo cp chatterbox-gateway.env.example /etc/chatterbox-gateway.env
#   sudo chown root:gateway /etc/chatterbox-gateway.env
#   sudo chmod 640 /etc/chatterbox-gateway.env

# REQUIRED: Shared secret for client authentication (min 16 chars)
# Generate with: openssl rand -base64 32
GATEWAY_PASSWORD=your-secure-random-password-here

# Optional: IRC server to connect to (TLS)
GATEWAY_IRC_HOST=irc.libera.chat
GATEWAY_IRC_PORT=6697

# Optional: Password for IRC server (if required)
# GATEWAY_IRC_PASSWORD=irc-server-password

# Optional: Gateway listen address/port
GATEWAY_LISTEN_HOST=0.0.0.0
GATEWAY_LISTEN_PORT=6667

# Optional: Connection limits
GATEWAY_MAX_CONN=100
GATEWAY_MAX_CONN_PER_IP=10
GATEWAY_RATE_LIMIT=10

# Optional: Timeouts (seconds)
GATEWAY_CONNECT_TIMEOUT=15
GATEWAY_IDLE_TIMEOUT=300

# Optional: Logging
GATEWAY_LOG_LEVEL=INFO

# SECURITY: TLS verification MUST be true in production
# Setting to false allows MITM attacks on the IRC leg
GATEWAY_TLS_VERIFY=true

# Minimum gateway password length (enforced at startup)
GATEWAY_MIN_PASSWORD_LEN=16